# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
# uv.lock IS committed — it pins the exact reproducible environment.

# Data and run artefacts (regenerable; never the source of truth).
# .gitkeep files preserve the directory structure.
data/*
!data/.gitkeep
runs/*
!runs/.gitkeep
# Track gate/run decision records (memos + the Phase 3 architecture spec) and the
# numeric intermediates, while keeping the heavy regenerable bulk (logs, config/meta,
# checkpoints, .h5/.parquet) ignored. Git needs each dir un-ignored before a file
# inside it can be re-included, so: allow subdirs, re-ignore their contents, then
# allow only the records + the CSV/JSON tables.
!runs/*/
runs/*/*
!runs/*/memo.md
!runs/*/phase3_architecture.md
# Numeric intermediates (tiny CSV/JSON, ~1 MB total): every figure regenerates from a
# fresh clone via replot.py / make_paper_figures.py (the D1 reproduce.sh chain).
!runs/*/tables/
runs/*/tables/*
!runs/*/tables/*.csv
!runs/*/tables/*.json
figures/*
!figures/.gitkeep
# The curated paper set (deterministic SVGs; see figures.apply_style) — versioned and
# viewable on GitHub. Scratch / other figure outputs stay ignored.
!figures/fig*.svg

# Activation stores
*.h5
*.hdf5
*.parquet
*.safetensors

# Notebooks are for exploration only
.ipynb_checkpoints/

# LaTeX build artefacts (paper/) — latexmk regenerates them; the sources
# (paper.tex, sections/, references.bib, .latexmkrc, README.md) AND the built
# paper.pdf are tracked (the PDF is the deliverable and is versioned
# deliberately); svg-inkscape/ is the svg package's Inkscape conversion cache.
paper/*.aux
paper/sections/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/svg-inkscape/
